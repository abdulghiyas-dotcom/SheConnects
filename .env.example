# SheConnects — every setting the app reads.
#
# Local:  copy to .env.local and fill in.
# Vercel: Project → Settings → Environment Variables → paste this whole file
#         (filled in) into the first "Key" box; Vercel splits it into rows.
#         Tick Production and Preview. Redeploy afterwards: NEXT_PUBLIC_ values
#         are built into the site, so they only change on a new deployment.
#
# Check a deployment at https://<your-site>/api/health

# ── Required: sign-in, dashboards and every button ───────────────────────────

# Supabase → Connect → "Transaction pooler" (port 6543). Keep the suffix.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase → Connect → "Session pooler" or "Direct connection" (port 5432). Used by `prisma db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Only needed to run the seed script (creates test log-ins). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# The public address of the site, used in email links. No trailing slash.
NEXT_PUBLIC_APP_URL="https://<your-site>.vercel.app"

# ── Optional: card payments (Stripe) ─────────────────────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Stripe → Developers → Webhooks → endpoint https://<your-site>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# ── Optional: file uploads (Cloudflare R2) ───────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── Optional: notification emails (Resend) ───────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@sheconnects.work"
RESEND_FROM_NAME="SheConnects"

# ── Optional: AI matching on the project brief ───────────────────────────────
GROQ_API_KEY=""
GOOGLE_AI_API_KEY=""
HUGGINGFACE_API_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
